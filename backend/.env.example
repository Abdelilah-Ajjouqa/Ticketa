# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/db_name

# JWT Configuration
JWT_SECRET=your-secret-jwt-key---you-can-use-this-commande-on-terminal-(node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")

# Server Configuration
PORT=3000

# Email / SMTP Configuration (Optional: defaults to console/mock logger in dev)
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-pass
# EMAIL_FROM="Ticketa <no-reply@ticketa.local>"